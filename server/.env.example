# Isi salah satu (atau lebih) API key gratis di bawah ini untuk mengaktifkan
# fitur Rekomendasi Produk Unggulan (AI) di halaman Profil Desa.
# Jika lebih dari satu diisi, dicoba berurutan: Groq -> Gemini -> Anthropic
# (jatuh ke provider berikutnya bila satu gagal/limit habis).

# Gratis, tanpa kartu kredit: https://console.groq.com/keys
GROQ_API_KEY=

# Gratis, tanpa kartu kredit: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Berbayar (opsional): https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Opsional, override model default per provider:
# GROQ_MODEL=openai/gpt-oss-120b
# GEMINI_MODEL=gemini-3.6-flash
# ANTHROPIC_MODEL=claude-sonnet-5

# ---- Login (wajib untuk fitur login/role akses) ----

# Kunci rahasia untuk menandatangani sesi login (cookie JWT). Isi string
# acak panjang, mis. hasil dari: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Client ID & Secret dari Google Cloud Console (OAuth Client ID, tipe "Web
# application"). Authorized redirect URI harus persis:
#   <PUBLIC_URL>/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Kode registrasi admin pertama, dipakai sekali untuk mendaftar akun admin
# awal lewat halaman Login -> Daftar Baru. Isi string acak, mis. hasil dari:
# node -e "console.log(require('crypto').randomBytes(6).toString('hex').toUpperCase())"
ADMIN_BOOTSTRAP_CODE=

# URL publik aplikasi ini (tanpa trailing slash), dipakai untuk redirect
# OAuth Google dan link balik setelah login. Untuk dev lokal:
#   PUBLIC_URL=http://localhost:5502
# Untuk produksi (Railway dst.), isi domain publik sebenarnya, mis.
#   PUBLIC_URL=https://nama-app-anda.up.railway.app
PUBLIC_URL=
